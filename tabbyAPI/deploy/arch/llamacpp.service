[Unit]
Description=llama-server (GGUF)
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-__TABBY_DIR__/model_profiles/llama.env
ExecStart=__TABBY_DIR__/deploy/arch/llama-start.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llamacpp
Nice=10
OOMScoreAdjust=800
OOMPolicy=kill
MemoryAccounting=yes
MemoryHigh=16G
MemoryMax=18G
MemorySwapMax=2G

# Do not enable at boot. GPU is exclusive. Tabby starts this unit on
# startup when gpu_mode.json is llama (last GGUF), or via a GGUF switch.

[Install]
WantedBy=default.target
