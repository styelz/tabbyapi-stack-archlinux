# Copy to deploy/arch/tabby.env (that file is gitignored).
# systemd --user reads it via EnvironmentFile= on tabbyapi.service.
# Lines are KEY=value. Do not use export. Leave a value blank to use the default.
# After edits: systemctl --user restart tabbyapi

# -----------------------------------------------------------------------------
# ComfyUI
# -----------------------------------------------------------------------------

# ComfyUI tree (Linux default: $HOME/tabbyapi-stack/ComfyUI).
COMFYUI_DIR=$HOME/tabbyapi-stack/ComfyUI

# ComfyUI HTTP API.
COMFYUI_URL=http://127.0.0.1:8188

# -----------------------------------------------------------------------------
# Public gallery / reverse SSH tunnel (all optional)
# -----------------------------------------------------------------------------

# Base URL written into image markdown for remote IDEs.
# Blank = use the Host the client already called (not 127.0.0.1).
# Set this when a reverse tunnel would otherwise expose localhost URLs.
TABBY_PUBLIC_BASE=

# Reverse tunnel. Unset = no ssh. Example: user@host.example
TABBY_SSH_REMOTE=

# Remote listen -> local TabbyAPI (default below).
TABBY_SSH_FORWARD=127.0.0.1:12345:127.0.0.1:5000

# Private key for TABBY_SSH_REMOTE (default: $HOME/.ssh/id_ed25519).
TABBY_SSH_KEY=$HOME/.ssh/id_ed25519

# -----------------------------------------------------------------------------
# Logging (also used without this file)
# -----------------------------------------------------------------------------

# Console wrap width. The unit already sets 256.
TABBY_LOG_CONSOLE_WIDTH=256

# DEBUG, INFO, WARNING, ERROR (default: INFO).
TABBY_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Hugging Face (installer / fetch_models.py, gated Gemma repos)
# -----------------------------------------------------------------------------

# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=

# -----------------------------------------------------------------------------
# TTY screensaver (tabby-saver system unit)
# -----------------------------------------------------------------------------

# 1 = enable the KMS kiosk on a spare VT. 0 = leave it installed but off.
# Do not enable if Omarchy or another desktop already owns the GPU.
TABBY_SAVER_ENABLED=0

# Seconds without input while logged in on the console before the field returns.
TABBY_SAVER_IDLE_S=120

# Seconds after logout / idle at the login prompt before the field returns.
TABBY_SAVER_LOGOUT_IDLE_S=10

# Seconds the idle clock and labels stay up. 0 hides them.
TABBY_SAVER_HUD_S=300

# TABBY_SAVER_TTY=tty8
# TABBY_SAVER_USER_TTY=tty1

# -----------------------------------------------------------------------------
# NVIDIA GPU (tsctl gpu / Settings → GPU). Applied by tabby-gpu.service.
# Fan writes need root NVML. auto keeps idle fan-stop; other profiles use a
# temperature curve. quiet also lowers the power limit.
# -----------------------------------------------------------------------------

# auto | quiet | balanced | performance | custom
TABBY_GPU_PROFILE=auto

# Custom fan percent when profile=custom. 0 = driver auto. Manual floor is often 30.
TABBY_GPU_FAN_SPEED=0

# Watts. 0 = profile default (quiet ~half range; others = driver default).
TABBY_GPU_POWER_LIMIT=0

# 1 = nvidia-smi persistence mode. Leave unset to not change it.
# TABBY_GPU_PERSISTENCE=1

# -----------------------------------------------------------------------------
# Installer only (export in the shell; install.sh does not read tabby.env)
# -----------------------------------------------------------------------------

# TABBY_INSTALL_ROOT=$HOME/tabbyapi-stack
# TABBY_CACHE=
# TABBY_MODELS=core
# TABBY_NONINTERACTIVE=1
# TABBY_INSTALL_VERBOSE=1
# TABBY_NETWORK_HOST=0.0.0.0
# TABBY_NETWORK_PORT=5000
# COMFYUI_URL=http://127.0.0.1:8188
# TABBY_PUBLIC_BASE=
# TABBY_SSH_REMOTE=
# TABBY_SSH_FORWARD=127.0.0.1:12345:127.0.0.1:5000
# TABBY_SSH_KEY=$HOME/.ssh/id_ed25519
# TABBY_SAVER_TTY=tty8
# TABBY_SAVER_USER_TTY=tty1

# -----------------------------------------------------------------------------
# config.yml overrides: TABBY_<SECTION>_<FIELD>
# Same keys as config.yml / config_sample.yml. Only set what you need.
# Examples:
# -----------------------------------------------------------------------------

# TABBY_NETWORK_HOST=127.0.0.1
# TABBY_NETWORK_PORT=5000
# TABBY_NETWORK_DISABLE_AUTH=true
# TABBY_NETWORK_DISABLE_FETCH_REQUESTS=true
# TABBY_NETWORK_SEND_TRACEBACKS=false
# TABBY_NETWORK_SSE_PING_INTERVAL=15

# TABBY_LOGGING_LOG_PROMPT=false
# TABBY_LOGGING_LOG_GENERATION_PARAMS=false
# TABBY_LOGGING_LOG_REQUESTS=false
# TABBY_LOGGING_LOG_CHAT_COMPLETION_REQUESTS=false

# TABBY_MODEL_MODEL_DIR=models
# TABBY_MODEL_MODEL_NAME=
# TABBY_MODEL_INLINE_MODEL_LOADING=false
# TABBY_MODEL_USE_DUMMY_MODELS=false
# TABBY_MODEL_BACKEND=exllamav3
# TABBY_MODEL_MAX_SEQ_LEN=
# TABBY_MODEL_CACHE_SIZE=
# TABBY_MODEL_CACHE_MODE=FP16
# TABBY_MODEL_TENSOR_PARALLEL=false
# TABBY_MODEL_GPU_SPLIT_AUTO=true
# TABBY_MODEL_CHUNK_SIZE=2048
# TABBY_MODEL_OUTPUT_CHUNKING=true
# TABBY_MODEL_VISION=false
# TABBY_MODEL_REASONING=false
# TABBY_MODEL_TOOL_FORMAT=

# TABBY_DRAFT_MODEL_DRAFT_MODE=model
# TABBY_DRAFT_MODEL_DRAFT_MODEL_DIR=models
# TABBY_DRAFT_MODEL_DRAFT_MODEL_NAME=

# TABBY_EMBEDDINGS_EMBEDDING_MODEL_DIR=models
# TABBY_EMBEDDINGS_EMBEDDINGS_DEVICE=cpu
# TABBY_EMBEDDINGS_EMBEDDING_MODEL_NAME=Qwen3-Embedding-0.6B

# TABBY_SAMPLING_OVERRIDE_PRESET=safe_defaults

# TABBY_LORA_LORA_DIR=loras

# TABBY_MEMORY_SYSMEM_RECURRENT_CACHE=4096
# TABBY_MEMORY_SYSMEM_KV_CACHE=0
# TABBY_MEMORY_CUDA_MALLOC_ASYNC=true

# TABBY_DEVELOPER_UNSAFE_LAUNCH=false
# TABBY_DEVELOPER_DISABLE_REQUEST_STREAMING=false
# TABBY_DEVELOPER_REALTIME_PROCESS_PRIORITY=false
