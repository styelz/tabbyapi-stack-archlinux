[Unit]
Description=Tabby-stack LLM activity screensaver (KMS kiosk)
Documentation=file://__TABBY_DIR__/deploy/arch/README.md
After=systemd-user-sessions.service plymouth-quit.service
Wants=systemd-user-sessions.service
# Runs on a spare VT as soon as Plymouth releases DRM. Do not wait for
# network-online or getty: those delay the first paint by the idle/logout
# wait (and getty Type=idle is several seconds after splash). tty1 stays
# getty in the background; a key/mouse drops the field and chvt back; idle
# (logged in) or logout-idle (login prompt) brings it back after that.
# Do not enable if Omarchy or a graphical session already owns this GPU.
ConditionPathExistsGlob=/dev/dri/card*

[Service]
Type=simple
User=__SAVER_USER__
SupplementaryGroups=video input tty
PAMName=login
TTYPath=/dev/__SAVER_TTY__
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tabby-saver
AmbientCapabilities=CAP_SYS_TTY_CONFIG
CapabilityBoundingSet=CAP_SYS_TTY_CONFIG
EnvironmentFile=-__TABBY_DIR__/deploy/arch/tabby.env
Environment=HOME=__SAVER_HOME__
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_RENDER_DRIVER=software
Environment=LIBGL_ALWAYS_SOFTWARE=1
Environment=SDL_AUDIODRIVER=dummy
Environment=PYGAME_HIDE_SUPPORT_PROMPT=1
Environment=TABBY_SAVER_URL=__SAVER_URL__
Environment=TABBY_SAVER_TTY=__SAVER_TTY__
Environment=TABBY_SAVER_USER_TTY=__USER_TTY__
UnsetEnvironment=DISPLAY WAYLAND_DISPLAY
WorkingDirectory=__TABBY_DIR__/deploy/arch
ExecStart=/usr/bin/python -u __TABBY_DIR__/deploy/arch/tabby-saver.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
