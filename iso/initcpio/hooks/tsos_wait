#!/usr/bin/ash

# udev's early hook starts udevd immediately before this hook. Trigger only
# display devices now so their seat metadata and device nodes exist before
# Plymouth chooses a renderer. Starting Plymouth before udev works in QEMU but
# makes some physical UEFI systems permanently select Plymouth's "..." text
# renderer instead of the TSOS DRM theme.
graphics_ready() {
    local device
    for device in /dev/dri/card* /dev/fb0; do
        [ -e "$device" ] && return 0
    done
    return 1
}

run_earlyhook() {
    local i
    [ -x /usr/bin/plymouthd ] && [ -x /usr/bin/plymouth ] || return 0
    /usr/bin/plymouth --ping >/dev/null 2>&1 && return 0

    if command -v udevadm >/dev/null 2>&1; then
        udevadm trigger --action=add --attr-match=class=0x030000 \
            >/dev/null 2>&1 || true
        udevadm trigger --action=add \
            --subsystem-match=drm --subsystem-match=graphics \
            >/dev/null 2>&1 || true
        udevadm settle --timeout=5 >/dev/null 2>&1 || true
    fi
    i=0
    while ! graphics_ready && [ "$i" -lt 50 ]; do
        sleep 0.1
        i=$((i + 1))
    done
    # Never start Plymouth without graphics: that is the three large dots
    # seen on hardware where DRM appears later. run_hook paints a tty fallback.
    graphics_ready || return 0

    mkdir -p /run/plymouth /dev/pts
    mountpoint -q /dev/pts 2>/dev/null ||
        mount -t devpts -o noexec,nosuid,gid=5,mode=0620 devpts /dev/pts 2>/dev/null ||
        true
    /usr/bin/plymouthd --mode=boot \
        --pid-file=/run/plymouth/pid --attach-to-session >/dev/null 2>&1 || true
    /usr/bin/plymouth --show-splash >/dev/null 2>&1 || true
}

run_hook() {
    local tty=/dev/tty0

    # The early start succeeded. Reassert the splash after the remaining
    # early hooks without overwriting its framebuffer from the text console.
    if /usr/bin/plymouth --ping >/dev/null 2>&1; then
        /usr/bin/plymouth --show-splash >/dev/null 2>&1 || true
        return 0
    fi

    [ -w "$tty" ] || return 0

    # BIOS/no-DRM fallback once a text console exists.
    {
        printf '\033[?25l\033[2J\033[H'
        printf '\033[44;97m'
        printf '\033[10;34H+---------+'
        printf '\033[11;34H|  TSOS   |'
        printf '\033[12;34H+---------+'
        printf '\033[15;37HLOADING'
        printf '\033[17;35HPLEASE WAIT'
        printf '\033[0m'
    } >"$tty"
}

# Keep the initramfs Plymouth daemon connected after switch-root. These are
# normally supplied by Arch's runtime hook, which TSOS replaces so it can
# control exactly when the daemon starts.
run_latehook() {
    /usr/bin/plymouth update-root-fs --new-root-dir=/new_root \
        >/dev/null 2>&1 || true
}

run_emergencyhook() {
    /usr/bin/plymouth --wait quit >/dev/null 2>&1 || true
}
